\@writefile{toc}{\contentsline {paragraph}{Pipeline at a glance.}{2}{section*.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces NAICS-GH end-to-end pipeline. A Presto/Trino SQL extraction from GitHub's data warehouse yields a source pool of 1{,}372{,}489 public repositories across three jurisdictional extractions (510{,}380 USA + 530{,}898 EU + 331{,}211 AU), each processed by an identical pipeline configuration; per-row country attributes are not retained in any released artifact. BAAI/bge-large-en embeddings indexed in FAISS retrieve the top-$k$ most semantically similar repositories per NAICS subindustry query ($k = \qopname  \relax m{max}(20, \lceil 400/n \rceil )$ for a sector with $n$ subindustries), producing \textbf  {31{,}178 unique candidate (repository, sector) pairs} after per-sector deduplication (10{,}983 USA + 10{,}531 EU + 9{,}664 AU). GPT-4.1 (snapshot \texttt  {gpt-4.1-2025-04-14}) scores each candidate against a structured rubric; we retain repositories with score $\geq 8$ and apply a minimum-class-size filter ($n{\geq }80$ per sector) to drop sector 55, yielding the released \textbf  {NAICS-GH} corpus of \textbf  {6{,}588 repositories} across 19 of the 20 NAICS 2-digit sectors.\relax }}{2}{figure.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{2}{NAICS-GH end-to-end pipeline. A Presto/Trino SQL extraction from GitHub's data warehouse yields a source pool of 1{,}372{,}489 public repositories across three jurisdictional extractions (510{,}380 USA + 530{,}898 EU + 331{,}211 AU), each processed by an identical pipeline configuration; per-row country attributes are not retained in any released artifact. BAAI/bge-large-en embeddings indexed in FAISS retrieve the top-$k$ most semantically similar repositories per NAICS subindustry query ($k = \max (20, \lceil 400/n \rceil )$ for a sector with $n$ subindustries), producing \textbf {31{,}178 unique candidate (repository, sector) pairs} after per-sector deduplication (10{,}983 USA + 10{,}531 EU + 9{,}664 AU). GPT-4.1 (snapshot \texttt {gpt-4.1-2025-04-14}) scores each candidate against a structured rubric; we retain repositories with score $\geq 8$ and apply a minimum-class-size filter ($n{\geq }80$ per sector) to drop sector 55, yielding the released \textbf {NAICS-GH} corpus of \textbf {6{,}588 repositories} across 19 of the 20 NAICS 2-digit sectors.\relax }{figure.caption.4}{}}
